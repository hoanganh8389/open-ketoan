    { "key": "hoa-don-dien-tu:cai-dat-sua", "label": "Hoá đơn điện tử — sửa cài đặt, đặt mật khẩu Viettel, thử kết nối", "roles": ["owner", "chief_accountant"], "risk": "high" }
