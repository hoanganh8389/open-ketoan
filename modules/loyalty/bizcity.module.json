{
  "contract": "bizcity_module@1",
  "id": "bizcity.loyalty",
  "key": "loyalty",
  "kind": "module",
  "version": "0.3.0",
  "label": "Điểm thành viên",
  "description": "Sổ điểm thành viên (NT-BH-020): chính sách khai / duyệt ở kế toán theo cửa hàng (NT-BH-039); tích / hoàn theo đơn máy bán; đổi quà / voucher; điều chỉnh điểm tay có duyệt; hết hạn lô; nạp số dư cũ; báo cáo BH19. Điểm chỉ hạch toán lúc đổi.",
  "owners": [
    "@hoanganh8389"
  ],
  "standard": "^1.0",
  "requires": {
    "capabilities": [
      "data.tenant-tx",
      "data.read-views",
      "data.migrations.module",
      "actions.runtime",
      "actions.idempotency",
      "evidence.receipt",
      "events.subscribe",
      "events.clock",
      "documents.versions",
      "documents.links"
    ]
  },
  "permissions": [
    {
      "key": "loyalty:read",
      "label": "Xem điểm thành viên: chính sách tích điểm của cửa hàng, số dư / lô / lịch sử điểm của khách (máy bán, kế toán)",
      "roles": [
        "owner",
        "chief_accountant",
        "accountant",
        "viewer"
      ],
      "risk": "low"
    },
    {
      "key": "loyalty:chinh-sach-lap",
      "label": "Chính sách tích điểm — lập nháp (sửa từ bản hiện hành, áp cho nhiều cửa hàng) (NT-BH-039)",
      "roles": [
        "owner",
        "chief_accountant",
        "accountant"
      ],
      "risk": "low"
    },
    {
      "key": "loyalty:chinh-sach-sua",
      "label": "Chính sách tích điểm — sửa nháp, gửi duyệt (chương trình, đổi điểm, cài đặt + hạng) (NT-BH-039)",
      "roles": [
        "owner",
        "chief_accountant",
        "accountant"
      ],
      "risk": "low"
    },
    {
      "key": "loyalty:chinh-sach-duyet",
      "label": "Chính sách tích điểm — duyệt / từ chối, duyệt = phát hành cho máy bán; người lập không tự duyệt (NT-BH-039)",
      "roles": [
        "owner",
        "chief_accountant"
      ],
      "risk": "high"
    },
    {
      "key": "loyalty:dieu-chinh-lap",
      "label": "Điều chỉnh điểm tay — lập yêu cầu cộng / trừ điểm kèm lý do (NT-BH-039)",
      "roles": [
        "owner",
        "chief_accountant",
        "accountant"
      ],
      "risk": "low"
    },
    {
      "key": "loyalty:dieu-chinh-duyet",
      "label": "Điều chỉnh điểm tay — duyệt / từ chối, duyệt = ghi sổ điểm; người lập không tự duyệt (NT-BH-039)",
      "roles": [
        "owner",
        "chief_accountant"
      ],
      "risk": "high"
    }
  ],
  "data": {
    "schema": "mod_loyalty",
    "tables": [
      "programs",
      "entries",
      "vouchers",
      "program_drafts",
      "adjustments",
      "approval_log"
    ],
    "reads": [
      "bizcity_read.partners",
      "bizcity_read.branches",
      "bizcity_read.products"
    ]
  },
  "actions": [
    "loyalty.program.put",
    "loyalty.program.get",
    "loyalty.customer.get",
    "loyalty.redeem.quote",
    "loyalty.voucher.get",
    "loyalty.opening.import",
    "loyalty.report.get",
    "loyalty.order.points",
    "loyalty.draft.list",
    "loyalty.draft.get",
    "loyalty.draft.create",
    "loyalty.draft.update",
    "loyalty.draft.approve",
    "loyalty.draft.reject",
    "loyalty.adjustment.list",
    "loyalty.adjustment.get",
    "loyalty.adjustment.create",
    "loyalty.adjustment.approve",
    "loyalty.adjustment.reject"
  ],
  "events": {
    "subscribes": [
      {
        "type": "pos.order.recorded",
        "version": 1
      },
      {
        "type": "pos.return.recorded",
        "version": 1
      },
      {
        "type": "bizcity.clock.daily",
        "version": 1
      }
    ]
  },
  "ui": {
    "icon": "Award",
    "color": "#b45309",
    "order": 31
  },
  "extensions": {
    "screens": [
      {
        "key": "loyalty.diem",
        "code": "BH19",
        "group": "Bán hàng",
        "label": "Điểm thành viên",
        "path": "/app/loyalty/diem",
        "operations": {
          "xem": {
            "permission": "loyalty:read",
            "label": "Xem",
            "kind": "xem"
          },
          "lapChinhSach": {
            "permission": "loyalty:chinh-sach-lap",
            "label": "Lập nháp chính sách",
            "kind": "ghi"
          },
          "suaChinhSach": {
            "permission": "loyalty:chinh-sach-sua",
            "label": "Sửa / gửi duyệt chính sách",
            "kind": "ghi"
          },
          "duyetChinhSach": {
            "permission": "loyalty:chinh-sach-duyet",
            "label": "Duyệt chính sách",
            "kind": "ghi"
          },
          "lapDieuChinh": {
            "permission": "loyalty:dieu-chinh-lap",
            "label": "Lập điều chỉnh điểm",
            "kind": "ghi"
          },
          "duyetDieuChinh": {
            "permission": "loyalty:dieu-chinh-duyet",
            "label": "Duyệt điều chỉnh điểm",
            "kind": "ghi"
          }
        }
      }
    ]
  }
}
